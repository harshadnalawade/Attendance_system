    import pyttsx3
except Exception:
    pyttsx3 = None

# ==========================================================
# ⚠️ TWILIO CLOUD GATEWAY CONFIGURATION
# ==========================================================
# Get these credentials by signing up for a free sandbox at twilio.com
TWILIO_ACCOUNT_SID = "YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN = "YOUR_TWILIO_AUTH_TOKEN"
TWILIO_VIRTUAL_NUMBER = "+1XXXXXXXXXX"  # Your purchased Twilio phone number
TWILIO_WHATSAPP_NUMBER = "whatsapp:+1XXXXXXXXXX"  # Your Twilio WhatsApp number (format: whatsapp:+1234567890)

def send_sms_notification(student_name, mobile_number):
    """Dispatches real-time text alert via Twilio network rails."""
    if not Client:
        print("⚠️ Warning: twilio library not installed. SMS transmission skipped.")
        return
    
    if not mobile_number or mobile_number.strip() in ('', 'N/A'):
        print(f"⏩ SMS skipped for {student_name}: No structural mobile number recorded.")
        return

    # Validate configuration parameters are filled
    if "YOUR_" in TWILIO_ACCOUNT_SID or "YOUR_" in TWILIO_AUTH_TOKEN:
        print("⚠️ Warning: Twilio API credentials placeholder detected. Configure credentials to send SMS alerts.")
        return

    try:
        client = Client(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)
        now_str = datetime.now().strftime("%I:%M %p")
        
        message_body = f"Attendance Alert: Dear student, {student_name} has been marked PRESENT at {now_str}."
        
        # Send SMS via live REST API gateway
        message = client.messages.create(
            body=message_body,
            from_=TWILIO_VIRTUAL_NUMBER,
            to=mobile_number.strip()  # Must include country code, e.g., +919876543210
        )
        print(f"📱 SMS successfully queued to cellular networks for {student_name} (ID: {message.sid})")
    except Exception as e:
        print(f"❌ Failed to dispatch SMS network frame: {e}")


