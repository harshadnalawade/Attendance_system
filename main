def send_absence_reason_to_students():
    """Send recorded absence reasons back to students via SMS."""
    print("\n" + "="*60)
    print("📲 SEND ABSENCE REASONS TO STUDENTS")
    print("="*60)
    
    if not os.path.exists(ABSENT_REASONS_FILE):
        print("❌ No absence reasons recorded yet.")
        return
    
    # Load student profiles for phone numbers
    profiles_dict = {}
    try:
        with open(PROFILES_CSV, mode='r', newline='') as pf:
            reader = csv.DictReader(pf)
            for row in reader:
                name = row.get('Name', '').upper().strip()
                roll = row.get('Roll', '').strip()
                mobile = row.get('Mobile', '').strip()
                profiles_dict[name] = {'roll': roll, 'mobile': mobile}
    except Exception as ex:
        print(f"❌ Error reading profiles: {ex}")
        return
    
    # Read all recorded absence reasons
    try:
        with open(ABSENT_REASONS_FILE, mode='r', newline='') as rf:
            reader = csv.DictReader(rf)
            reasons_list = list(reader)
    except Exception as ex:
        print(f"❌ Error reading reasons: {ex}")
        return
    
    if len(reasons_list) <= 0:
        print("❌ No absence reasons recorded yet.")
        return
    
    print(f"\n📋 Total reasons to send: {len(reasons_list)}\n")
    
    # Display reasons to send
    for idx, entry in enumerate(reasons_list, 1):
        name = entry.get('Name', 'N/A')
        date_val = entry.get('Date', 'N/A')
        reason = entry.get('Reason', 'N/A')
        print(f"{idx}. {name} ({date_val}): {reason}")
    
    confirm = input("\n⚠️ Send all recorded reasons to students' phones? (yes/no): ").strip().lower()
    if confirm != 'yes':
        print("❌ Message sending canceled.")
        return
    
    print("\n📤 Sending absence reasons to students...")
    success_count = 0
    failed_count = 0
    
    for entry in reasons_list:
        name = entry.get('Name', '').upper().strip()
        roll = entry.get('Roll', '').strip()
        date_val = entry.get('Date', '').strip()
        reason = entry.get('Reason', '').strip()
        
        # Get mobile number from profiles
        if name not in profiles_dict:
            print(f"⏩ Skipped {name}: Profile not found.")
            failed_count += 1
            continue
        
        mobile = profiles_dict[name]['mobile']
        
        if not mobile:
            print(f"⏩ Skipped {name}: No phone number on file.")
            failed_count += 1
            continue
        
        # Construct message with recorded reason
        message_text = f"Dear {name}, Your absence reason for {date_val} has been recorded: '{reason}'. Thank you for your response."
        
        if send_sms_message(name, mobile, message_text):
            success_count += 1
        else:
            failed_count += 1
    
    print(f"\n✅ Absence reason notification complete: {success_count} sent, {failed_count} failed")


def send_whatsapp_message_to_student():
    """Send a WhatsApp message to a specific student."""
    print("\n" + "="*60)
    print("💬 SEND WHATSAPP MESSAGE TO STUDENT")
    print("="*60)
    
    if not os.path.exists(PROFILES_CSV):
        print("❌ No profiles found.")
        return
    
    # Load all profiles
    profiles_list = []
    try:
        with open(PROFILES_CSV, mode='r', newline='') as pf:
            reader = csv.DictReader(pf)
            profiles_list = list(reader)
    except Exception as ex:
        print(f"❌ Error reading profiles: {ex}")
        return
    
    if not profiles_list:
        print("❌ No profiles found.")
        return
    
    # Display all profiles
    print("\n🔍 Available Students:")
    for idx, profile in enumerate(profiles_list, 1):
        name = profile.get('Name', 'N/A')
        roll = profile.get('Roll', 'N/A')
        mobile = profile.get('Mobile', 'N/A') or 'No Phone'
        print(f"   {idx}. {name} ({roll}) - {mobile}")
    
    try:
        choice = input(f"\n📌 Enter student number (1-{len(profiles_list)}) to message: ").strip()
        idx = int(choice) - 1
        
        if idx < 0 or idx >= len(profiles_list):
            print("❌ Invalid selection.")
            return
        
        selected = profiles_list[idx]
        name = selected.get('Name', '').upper()
        mobile = selected.get('Mobile', '')
        
        print(f"\n✏️ WhatsApp message to: {name}")
        message_text = input("📝 Enter message (max 160 characters recommended): ").strip()
        
        if not message_text:
            print("⏭️ Message not sent (empty).")
            return
        
        send_whatsapp_message(name, mobile, message_text)
        
    except ValueError:
        print("❌ Invalid input.")
    except Exception as ex:
        print(f"❌ Error: {ex}")


def send_whatsapp_broadcast():
    """Send a WhatsApp message to all enrolled students."""
    print("\n" + "="*60)
    print("📢 BROADCAST WHATSAPP MESSAGE TO ALL STUDENTS")
    print("="*60)
    
    if not os.path.exists(PROFILES_CSV):
        print("❌ No profiles found.")
        return
    
    # Load all profiles
    profiles_list = []
    try:
        with open(PROFILES_CSV, mode='r', newline='') as pf:
            reader = csv.DictReader(pf)
            profiles_list = list(reader)
    except Exception as ex:
        print(f"❌ Error reading profiles: {ex}")
        return
    
    if not profiles_list:
        print("❌ No profiles found.")
        return
    
    print(f"\n📋 Total students: {len(profiles_list)}")
    for idx, profile in enumerate(profiles_list, 1):
        name = profile.get('Name', 'N/A')
        mobile = profile.get('Mobile', '') or 'No Phone'
        print(f"   {idx}. {name} - {mobile}")
    
    confirm = input("\n⚠️ Send WhatsApp message to ALL students? (yes/no): ").strip().lower()
    if confirm != 'yes':
        print("❌ Broadcast canceled.")
        return
    
    message_text = input("\n📝 Enter message (max 160 characters recommended): ").strip()
    if not message_text:
        print("⏭️ Broadcast not sent (empty message).")
        return
    
    print("\n📤 Sending WhatsApp broadcast messages...")
    success_count = 0
    failed_count = 0
    
    for profile in profiles_list:
        name = profile.get('Name', '').upper()
        mobile = profile.get('Mobile', '')
        if send_whatsapp_message(name, mobile, message_text):
            success_count += 1
        else:
            failed_count += 1
    
    print(f"\n✅ WhatsApp Broadcast complete: {success_count} sent, {failed_count} failed")


def view_message_log():
    """View all sent messages."""
    print("\n" + "="*60)
    print("📜 MESSAGE LOG")
    print("="*60)
    
    if not os.path.exists(MESSAGE_LOG_FILE):
        print("❌ No message log found yet.")
        return
    
    try:
        with open(MESSAGE_LOG_FILE, 'r', encoding='utf-8') as log_file:
            messages = log_file.readlines()
        
        if not messages:
            print("❌ Message log is empty.")
            return
        
        print(f"\n📋 Total messages: {len(messages)}\n")
        # Show last 20 messages
        for msg in messages[-20:]:
            print(msg.rstrip())
        
        if len(messages) > 20:
            print(f"\n... ({len(messages) - 20} more messages) ...")
    except Exception as ex:
        print(f"❌ Error reading message log: {ex}")


def messaging_menu():
    """Main messaging menu."""
    while True:
        print("\n" + "="*60)
        print("📨 MESSAGING SYSTEM")
        print("="*60)
        print("1️⃣  Send SMS to a student")
        print("2️⃣  Send SMS broadcast to all students")
        print("3️⃣  Send message to all PRESENT students")
        print("4️⃣  Send message to ABSENT students (ask for reason)")
        print("5️⃣  Send absence reasons to students (confirmation)")
        print("6️⃣  Send WhatsApp to a student")
        print("7️⃣  Send WhatsApp broadcast to all students")
        print("8️⃣  View message log")
        print("9️⃣  View absence statistics")
        print("🔟  Back to main menu")
        print("="*60)
        
        choice = input("Enter option (1-10): ").strip()
        
        if choice == '1':
            send_message_to_student()
        elif choice == '2':
            send_broadcast_message()
        elif choice == '3':
            send_message_to_present_students()
        elif choice == '4':
            send_message_to_absent_students()
        elif choice == '5':
            send_absence_reason_to_students()
        elif choice == '6':
            send_whatsapp_message_to_student()
        elif choice == '7':
            send_whatsapp_broadcast()
        elif choice == '8':
            view_message_log()
        elif choice == '9':
            view_absence_statistics()
        elif choice == '10':
            break
        else:
            print("❌ Invalid option. Try again.")


def match_face(face_roi_gray, known_profiles):
    """Match a detected face with known profiles and return match info."""
    best_match = None
    highest_similarity = 0
    saved_roll_in_match = ''
    saved_mobile_in_match = ''

    for name, data in known_profiles.items():
        try:
            saved_face_roi = data[0]
            saved_roll = data[1] if len(data) > 1 else ''
            saved_mobile = data[2] if len(data) > 2 else ''
            
            # Resize to standard matching metrics dimensions
            resized_live = cv2.resize(face_roi_gray, (100, 100))
            resized_saved = cv2.resize(saved_face_roi, (100, 100))
            
            # Check pixel correlation matrix similarity matching
            match_score = cv2.matchTemplate(resized_live, resized_saved, cv2.TM_CCOEFF_NORMED)[0][0]
            if match_score > highest_similarity and match_score > 0.45:
                highest_similarity = match_score
                best_match = name
                saved_roll_in_match = saved_roll
                saved_mobile_in_match = saved_mobile
        except:
            pass
    
    return best_match, saved_roll_in_match, saved_mobile_in_match


# Initial load of user profiles
known_profiles = load_known_faces()
logged_users = set()  # Tracks who was logged present in the current session

# 2. Fire up the Live Hardware Interface
webcam = cv2.VideoCapture(0)

print("\n==========================================================")
print("📷 SYSTEM ACTIVE: Look at the camera.")
print("👉 Press 'E' to ENROLL and save details for a new face.")
print("👉 Press 'C' to open camera and take a photo to enroll manually.")
print("👉 Press 'P' to UPDATE PHONE NUMBERS.")
print("👉 Press 'M' to ACCESS MESSAGING SYSTEM.")
print("👉 Press 'O' to MANAGE ACTIVE PROJECTS.")
print("👉 Press 'Q' inside the camera window to QUIT.")
print("==========================================================\n")

while True:
    ret, frame = webcam.read()
    if not ret:
        break

    gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    detected_faces = face_cascade.detectMultiScale(gray_frame, scaleFactor=1.3, minNeighbors=5)

    # Display active project on screen if one is active
    active_proj = get_active_project()
    if active_proj:
        cv2.putText(frame, f"🎯 ACTIVE PROJECT: {active_proj}", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

    # Render interactive HUD menus on screen space canvas
    cv2.putText(frame, "Press 'E' Enroll | 'C' Capture | 'P' Phone | 'M' Messages | 'O' Projects | 'Q' Quit", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

    # Collect per-frame detection info for interactive actions
    detected_info = []
    for idx, (x, y, w, h) in enumerate(detected_faces):
        face_roi_gray = gray_frame[y:y+h, x:x+w]
        face_roi_color = frame[y:y+h, x:x+w]
        
        name_status = "ABSENT / UNKNOWN"
        box_color = (0, 0, 255)  # Red box for Absent/Unknown

        # Compare current live face matrix with saved database profiles
        best_match, saved_roll_in_match, saved_mobile_in_match = match_face(face_roi_gray, known_profiles)

        # If matching target calculations pass the confidence matrix threshold
        if best_match:
            name_status = f"{best_match}: PRESENT"
            box_color = (0, 255, 0)  # Green box for Present
            
            # Log structural data timestamp details to spreadsheet automatically
            if best_match not in logged_users:
                # fetch roll and mobile if available
                roll_val = saved_roll_in_match or ''
                mobile_val = saved_mobile_in_match or ''
                save_present_log(best_match, roll_val, mobile_val)
                play_presence_sound()
                if roll_val:
                    speak_text(f"Present, {best_match}. Roll number {roll_val}")
                else:
                    speak_text(f"Present, {best_match}")
                logged_users.add(best_match)
            # Draw structural overlay wrappers and index for multi-face
            cv2.rectangle(frame, (x, y), (x + w, y + h), box_color, 3)
            cv2.putText(frame, name_status, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.7, box_color, 2)
            cv2.putText(frame, f"#{idx}", (x + w - 25, y + h - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)

            detected_info.append({
                'idx': idx,
                'bbox': (x, y, w, h),
                'best_match': best_match,
                'roll': saved_roll_in_match if best_match else '',
                'mobile': saved_mobile_in_match if best_match else '',
                'roi_color': face_roi_color,
                'roi_gray': face_roi_gray
            })
        else:
            # Unknown face: draw red box, show status and index, still append for interaction
            cv2.rectangle(frame, (x, y), (x + w, y + h), box_color, 3)
            cv2.putText(frame, name_status, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.7, box_color, 2)
            cv2.putText(frame, f"#{idx}", (x + w - 25, y + h - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)
            detected_info.append({
                'idx': idx,
                'bbox': (x, y, w, h),
                'best_match': None,
                'roll': '',
                'mobile': '',
                'roi_color': face_roi_color,
                'roi_gray': face_roi_gray
            })

    cv2.imshow('Interactive Enrollment & Attendance System', frame)
    key = cv2.waitKey(1) & 0xFF

    # Keyboard State Handlers
    if key == ord('e'):
        # Enroll a face: if single face, use it; if multiple, ask for index
        if len(detected_info) == 0:
            print("❌ No face detected to enroll.\n")
        else:
            chosen = 0
            if len(detected_info) > 1:
                print(f"Multiple faces detected ({len(detected_info)}). See indexes on boxes.")
                try:
                    choice = input(f"Enter index to enroll (0-{len(detected_info)-1}): ").strip()
                    chosen = int(choice)
                except Exception:
                    print("Invalid index entry. Enrollment canceled.")
                    chosen = None
            if chosen is not None:
                if chosen is None or chosen < 0 or chosen >= len(detected_info):
                    print("Invalid selection. Enrollment canceled.")
                else:
                    fx, fy, fw, fh = detected_info[chosen]['bbox']
                    enroll_face = frame[fy:fy+fh, fx:fx+fw]
                    print("\n📸 ENROLLING FACE: Look at your background shell window!")
                    new_name = input("✍️ Enter the name for this person: ").strip().upper()
                    new_roll = input("🔢 Enter roll number (optional): ").strip().upper()
                    new_mobile = input("📱 Enter mobile number (with country code, e.g., +9198765...): ").strip()
                    if not new_name:
                        print("❌ Enrollment canceled: Name cannot be left blank.\n")
                    else:
                        filename = os.path.join(DB_DIR, f"{new_name}.jpg")
                        # avoid overwrite unless confirmed
                        if os.path.exists(filename):
                            resp = input(f"Profile {new_name} exists. Overwrite? (y/N): ").strip().lower()
                            if resp != 'y':
                                print("Skipped saving to avoid overwrite.\n")
                            else:
                                cv2.imwrite(filename, enroll_face)
                        else:
                            cv2.imwrite(filename, enroll_face)
                        try:
                            with open(PROFILES_CSV, mode='a', newline='') as pf:
                                pw = csv.writer(pf)
                                pw.writerow([new_name, new_roll, new_mobile, os.path.basename(filename)])
                        except Exception as ex:
                            print(f"⚠️ Warning: failed to write profile metadata: {ex}")
                        print(f"💾 File saved successfully! Added {new_name} ({new_roll}) to database.\n")
                        known_profiles = load_known_faces()

    elif key == ord('q'):
        break
    elif key == ord('c'):
        # Temporarily release main webcam, run manual capture flow, then re-open
        webcam.release()
        saved = manual_capture()
        # reload profiles if a new file was saved
        known_profiles = load_known_faces()
        webcam = cv2.VideoCapture(0)
    elif key == ord('p') or key == ord('P'):
        # Update phone number for existing profile
        webcam.release()
        update_phone_number()
        known_profiles = load_known_faces()
        webcam = cv2.VideoCapture(0)
    elif key == ord('m') or key == ord('M'):
        # Open messaging system
        webcam.release()
        messaging_menu()
        known_profiles = load_known_faces()
        webcam = cv2.VideoCapture(0)
    elif key == ord('o') or key == ord('O'):
        # Open project management system
        webcam.release()
        project_management_menu()
        known_profiles = load_known_faces()
        webcam = cv2.VideoCapture(0)
    elif key == ord('v'):
        # View details for a detected face: choose index if multiple
        if len(detected_info) == 0:
            print("No face detected to view details.")
        else:
            chosen = 0
            if len(detected_info) > 1:
                try:
                    choice = input(f"Enter index to view (0-{len(detected_info)-1}): ").strip()
                    chosen = int(choice)
                except Exception:
                    print("Invalid index. Cancelled.")
                    chosen = None
            if chosen is not None:
                info = detected_info[chosen]
                if info['best_match']:
                    rollval = info['roll']
                    mobileval = info['mobile']
                    print(f"Profile: {info['best_match']}, Roll: {rollval}, Mobile: {mobileval}")
                else:
                    print("Face not recognized. Press 'E' to enroll this person.")

webcam.release()
cv2.destroyAllWindows()
